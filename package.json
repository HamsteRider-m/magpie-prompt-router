    "page": {
      "title": "Prompt Router",
      "titles": {
        "zh": "提示词路由",
        "en": "Prompt Router"
      },
      "file": "page/index.html"
    },
    "permissions": [],
    "options": {
      "enabled": true,
      "defaultMode": "off",
      "defaultPersonaId": "builtin-example",
      "defaultKeepCwd": true,
      "bypassAuxiliary": true,
      "allowExcludedModelsOnOnce": false,
      "excludedModelGlobs": [
        "*nmem*",
        "*embedding*",
        "*rerank*",
        "*jev*"
      ],
      "personas": [],
      "rules": [],
      "autoDiscoverProjectFile": true
    }
  },
  "bin": {
    "magpie-prompt-router": "bin/magpie-prompt-router.mjs",
    "mpr": "bin/magpie-prompt-router.mjs"
  }
}
