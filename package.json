{
  "name": "magpie-prompt-router",
  "version": "0.1.0",
  "description": "Conditional system prompt routing plugin for Magpie with /route and @route chat directives, auxiliary-call protection, and host-context cleaning.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamsteRider-m/magpie-prompt-router.git"
  },
  "homepage": "https://github.com/HamsteRider-m/magpie-prompt-router#readme",
  "bugs": {
    "url": "https://github.com/HamsteRider-m/magpie-prompt-router/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "prompt-router",
    "system-prompt",
    "middleware"
  ],
  "files": [
    "src",
    "page",
    "bin",
    "skills",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "node ./scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
